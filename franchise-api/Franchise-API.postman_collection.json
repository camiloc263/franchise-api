{
  "info": {
    "name": "Franchise API",
    "description": "API para gestionar franquicias y sus productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Obtener top productos por franquicia",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{id}/top-products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{id}", "top-products"]
        },
        "description": "Obtiene el producto con mayor stock de cada sucursal de una franquicia"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is array', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        },
        "description": "Verifica que la aplicación esté funcionando"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "user",
        "type": "string"
      },
      {
        "key": "password",
        "value": "password",
        "type": "string"
      }
    ]
  }
}